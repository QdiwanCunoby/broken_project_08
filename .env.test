# Ambiente di TEST — committato di proposito: tutti i valori sono finti e validi solo per i test.
# Lo carica tests/setup-env.ts prima di ogni file di test. Le variabili già presenti nell'ambiente (es. in CI) vincono.
NODE_ENV=test
LOG_LEVEL=silent
CORS_ORIGIN=http://localhost:5173

# Postgres dedicato ai test (docker-compose.test.yml, tmpfs). Porta 5434: la 5433 è già usata dal DB del G5.
DATABASE_URL="postgresql://liparibank_test:liparibank_test_pw@localhost:5434/liparibank_test?schema=public"

# Secret FINTI (>= 32 caratteri e diversi tra loro, come richiede src/config/env.ts)
JWT_ACCESS_SECRET=fake-test-access-secret-NOT-FOR-PRODUCTION-0123456789
JWT_REFRESH_SECRET=fake-test-refresh-secret-NOT-FOR-PRODUCTION-0123456789

# I test che usano il servizio AI avviano un finto upstream e passano il suo URL a createApp
AI_SERVICE_URL=http://127.0.0.1:1
# Upload dei test in una cartella temporanea, svuotata dalla suite
UPLOAD_DIR=.tmp/test-uploads
